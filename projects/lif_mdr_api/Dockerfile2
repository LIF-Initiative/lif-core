# Stage 1: Builder stage
FROM python:3.13-slim AS builder

# Build arguments for project configuration
ARG PROJECT_NAME=lif_mdr_api

# Install uv
RUN pip install --no-cache-dir uv

# Set UV environment variables for optimal caching and behavior
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Set working directory in the container
WORKDIR /code

# Copy the entire monorepo structure needed for polylith
COPY projects/${PROJECT_NAME}/ /code/projects/${PROJECT_NAME}/
COPY bases/ /code/bases/
COPY components/ /code/components/

# Change to the specific project directory
WORKDIR /code/projects/${PROJECT_NAME}

# Sync dependencies and build the project wheel
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev && \
    uv export --locked --no-dev --no-emit-project --no-hashes -o /code/constraints.txt && \
    uv build --wheel

# Stage 2: Final runtime image
FROM python:3.13-slim AS runtime
# Distrust the eMudhra emSign roots C1, C3 and G3, which certifi 2026.10.23 no longer carries, and
# Sectigo's Comodo AAA Services root, which cross-signs the compromised emSign intermediates (#1480).
# Debian's ca-certificates may still ship them. The grep fails the build if one is still trusted
# under a name the sed doesn't match.
RUN sed -i -E 's@^(mozilla/(emSign_(Root_CA_-_C1|ECC_Root_CA_-_C3|ECC_Root_CA_-_G3)|Comodo_AAA_Services_root)\.crt)$@!\1@' /etc/ca-certificates.conf \
    && ! grep -iqE '^mozilla/.*(emsign.*(c1|c3|g3)|aaa.?services)' /etc/ca-certificates.conf \
    && update-ca-certificates --fresh > /dev/null

# Inherit build arguments in runtime stage
ARG PROJECT_NAME=lif_mdr_api

# Install uv in runtime for faster package installation
RUN pip install --no-cache-dir uv

# Copy the built wheel from the builder stage
COPY --from=builder /code/projects/${PROJECT_NAME}/dist/*.whl /tmp/
COPY --from=builder /code/constraints.txt /tmp/constraints.txt

# Install the wheel in the final image, pinned to the versions in uv.lock
RUN uv pip install --system --constraint /tmp/constraints.txt /tmp/*.whl && \
    rm /tmp/*.whl /tmp/constraints.txt

# Set working directory
WORKDIR /code

# Use uvicorn to run the FastAPI application
CMD ["uvicorn", "lif.mdr_restapi.core:app", "--host", "0.0.0.0", "--port", "8012"]
