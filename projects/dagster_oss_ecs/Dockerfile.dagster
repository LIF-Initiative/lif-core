FROM python:3.13-slim

# Pinned to what dev's webserver/daemon have run since 2026-10-14 (#1490). 1.13.29 breaks the
# Orchestrator API's run submission, so upgrade Dagster deliberately, never by rebuilding.
RUN pip install \
    dagster==1.13.26 \
    dagster-graphql==1.13.26 \
    dagster-webserver==1.13.26 \
    dagster-postgres==0.29.26 \
    dagster-docker==0.29.26 \
    "sqlalchemy<2.1"

# Set $DAGSTER_HOME and copy dagster.yaml and workspace.yaml there
ENV DAGSTER_HOME=/opt/dagster/dagster_home/

RUN mkdir -p $DAGSTER_HOME

COPY projects/dagster_oss_ecs/dagster.yaml $DAGSTER_HOME
COPY projects/dagster_oss_ecs/workspace.yaml $DAGSTER_HOME

WORKDIR $DAGSTER_HOME
