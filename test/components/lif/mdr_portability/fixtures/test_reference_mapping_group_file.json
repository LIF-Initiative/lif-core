{
  "Format": {
    "Type": "lif-mdr-mapping-group",
    "Version": 1
  },
  "Details": {
    "Source": {
      "Name": "District SIS",
      "Version": "1.0",
      "ContributorOrganization": "District"
    },
    "Target": {
      "Name": "District LIF",
      "Version": "1.0",
      "ContributorOrganization": "District"
    },
    "Version": "1.0",
    "Name": "District SIS to District LIF",
    "Description": "Reference mapping group",
    "Tags": "district,reference"
  },
  "Mappings": [
    {
      "Target": {
        "Path": "Course,AccreditedBy,name"
      },
      "Sources": [
        {
          "Path": "School,nameOfInstitution"
        }
      ],
      "ExpressionLanguage": "JSONata",
      "Expression": "{ \"Course\": { \"AccreditedBy\": { \"name\": School.nameOfInstitution } } }",
      "Name": "Course.AccreditedBy.name"
    },
    {
      "Target": {
        "Path": "Course,ApprovedBy,name"
      },
      "Sources": [
        {
          "Path": "School,nameOfInstitution"
        }
      ],
      "ExpressionLanguage": "JSONata",
      "Expression": "{ \"Course\": { \"ApprovedBy\": { \"name\": School.nameOfInstitution } } }",
      "Name": "Course.ApprovedBy.name"
    },
    {
      "Target": {
        "Path": "Course,title",
        "Notes": "Display title"
      },
      "Sources": [
        {
          "Path": "Course,courseTitle",
          "Contributor": "District data team"
        }
      ],
      "ExpressionLanguage": "JSONata",
      "Expression": "{ \"Course\": { \"title\": Course.courseTitle } }",
      "Name": "Course.title",
      "Description": "Course title",
      "UseConsiderations": "Trimmed by the source system",
      "Alignment": "Exact",
      "Notes": "One to one",
      "Contributor": "District data team",
      "ContributorOrganization": "District",
      "ActivationDate": "2026-10-06T00:00:00Z"
    },
    {
      "Target": {
        "Path": "Person,Contact,Address,city"
      },
      "Sources": [
        {
          "Path": "Student,Address,addressTypeDescriptor"
        },
        {
          "Path": "Student,Address,city"
        }
      ],
      "ExpressionLanguage": "JSONata",
      "Expression": "(\n  $home := Student.Address[addressTypeDescriptor = \"Home\"];\n  { \"Person\": { \"Contact\": { \"Address\": { \"city\": $home.city } } } }\n)",
      "Name": "Person.Contact.Address.city"
    },
    {
      "Target": {
        "Path": "Person,Identifier,identifierType"
      },
      "Sources": [],
      "ExpressionLanguage": "JSONata",
      "Expression": "{ \"Person\": { \"Identifier\": { \"identifierType\": \"SIS\" } } }",
      "Name": "Person.Identifier.identifierType"
    }
  ]
}
