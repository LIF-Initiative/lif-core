# Copy to `.env` in this directory before running docker compose:
#
#     cp .env.example .env
#
# Only the first two are required. #1191 removed their insecure fallback defaults, so
# compose refuses to even *parse* this directory's docker-compose.yml without them --
# including for `docker compose config` and for bringing up a subset of services that
# does not use them. The values below are fine for local development and must never be
# used anywhere else; in AWS these come from SSM via each service's taskdef-includes.

# Login password for every demo persona in the Advisor API.
LIF_DEMO_USER_PASSWORD=changeme-local-only

# Signs and verifies the Advisor's JWTs.
SECRET_KEY=changeme-local-only-not-a-real-secret

# Optional. Only the Advisor API and the agent-backed services need it; leave blank to
# bring up the data-layer services (MongoDB, Query Cache, Query Planner, GraphQL).
OPENAI_API_KEY=
