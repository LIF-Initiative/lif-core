{
  "openapi": "3.0.0",
  "info": {
    "title": "Machine-Readable Schema for Sample LDE Target Test",
    "version": "1.0",
    "description": "Synthetic target data model for exercising the Learner Data Export end to end (issue #1224). Deliberately structured unlike StateU LIF: flat rows instead of nested LIF fragments, references flattened into strings, the two LIF preference entities merged, and provenance rolled up into per-row lists."
  },
